#: course/lesson-7-member-variables/draw_rectangles_at_positions/TestsDrawingRectangles.gd:40
msgid "Draw Three Squares"
msgstr "Rita tre kvadrater"

#: course/lesson-18-for-loops/for_rectangles/ForTestsDrawingRectangles.gd:43
#: course/lesson-7-member-variables/draw_rectangles_at_positions/TestsDrawingRectangles.gd:41
msgid "Squares Are All 100 By 100"
msgstr "Alla kvadrater är 100 × 100"

#: course/lesson-18-for-loops/for_rectangles/ForTestsDrawingRectangles.gd:46
#: course/lesson-7-member-variables/draw_rectangles_at_positions/TestsDrawingRectangles.gd:43
